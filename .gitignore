# ============================================================
# .gitignore for ctd_pipeline_v2  (PUBLIC repo)
# Commit CODE, docs, config. NEVER commit cruise data or PSAs.
# ============================================================

# --- Cruise data (raw + processed) - do NOT version-control ---
cruises/*/L0/
cruises/*/L1/
cruises/*/L2/
cruises/*/L3/
cruises/*/_audit/
cruises/*/_sbe_work/

# Sea-Bird no-space staging area, including the timestamped fallback folders
# the runner creates when the default one is locked (_sbe_work_YYYYMMDD_HHMMSS).
_sbe_work/
_sbe_work_*/
_audit/

# raw / processed instrument files anywhere
*.hex
*.HEX
*.cnv
*.CNV
*.ros
*.bl
*.btl
*.afm
*.bin
*.hdr
*.sed

# Sea-Bird PSA setup files - not tracked (local configuration).
# Ignore the whole psa/ folder and both cases, so nothing in it can be committed.
*.psa
*.PSA
psa/

# Tabular data files ANYWHERE (not only under cruises/). A public repo is unforgiving,
# so ignore every spreadsheet/table by default and force-keep only templates below.
*.csv
*.CSV
*.tsv
*.xlsx
*.xls
*.xlsm
*.nc
*.dat
*.mat

# compressed archives (often bundles of data)
*.zip
*.gz
*.tar
*.tgz
*.7z

# figures and plot outputs
*.png
*.jpg
*.jpeg
*.pdf
profile_plots/

# --- Environments / caches ---
.venv/
.venv_new/
venv/
env/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/

# --- IDE ---
.idea/
.vscode/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# EXCEPTIONS - force-keep small reference/config files that the
# rules above would otherwise catch. They come LAST so they win.
# Each matches ONLY the named or *_TEMPLATE file, so real data
# (e.g. P45_07_bottle_nitrate.csv, P45-07_chla_calc.csv) stays ignored.
# ============================================================
# SUNA cast map: a REAL cruise file (cast_id -> raw SUNA filename); no measurements.
!cruises/*/metadata/suna_cast_map.csv
# Bottle / discrete-sample column templates (show expected columns; no real data)
!cruises/*/metadata/bottle_nitrate/*_bottle_nitrate_TEMPLATE.csv
!**/chla/*_TEMPLATE.csv
!**/winkler_oxygen/*_TEMPLATE.csv
# Shared SUNA instrument calibration (factory reference, not cruise data)
!metadata/calibration/*.cal
